---
import BaseLayout from '../../layouts/BaseLayout.astro';
import qualityScoresData from '../../data/quality-scores.json';

const NAMES: Record<string,string> = {
  'portugal':'Portugal','spain':'Spain','poland':'Poland','mexico':'Mexico',
  'thailand':'Thailand','germany':'Germany','japan':'Japan','croatia':'Croatia',
  'czech-republic':'Czech Republic','hungary':'Hungary','romania':'Romania',
  'bulgaria':'Bulgaria','vietnam':'Vietnam','south-korea':'South Korea',
  'australia':'Australia','new-zealand':'New Zealand','canada':'Canada',
  'ireland':'Ireland','netherlands':'Netherlands','france':'France',
  'argentina':'Argentina','ecuador':'Ecuador','morocco':'Morocco',
  'switzerland':'Switzerland','norway':'Norway','denmark':'Denmark',
  'sweden':'Sweden','belgium':'Belgium','austria':'Austria','finland':'Finland',
  'united-kingdom':'United Kingdom','singapore':'Singapore',
  'united-arab-emirates':'UAE','qatar':'Qatar','saudi-arabia':'Saudi Arabia',
  'iceland':'Iceland','india':'India','philippines':'Philippines','china':'China',
  'georgia':'Georgia','serbia':'Serbia','kenya':'Kenya','peru':'Peru',
  'brazil':'Brazil','chile':'Chile','albania':'Albania','sri-lanka':'Sri Lanka',
  'egypt':'Egypt','indonesia':'Indonesia','colombia':'Colombia',
  'costa-rica':'Costa Rica','panama':'Panama','malaysia':'Malaysia',
  'italy':'Italy','greece':'Greece','bahamas':'Bahamas','belize':'Belize',
  'bolivia':'Bolivia','cambodia':'Cambodia','cyprus':'Cyprus',
  'dominican-republic':'Dominican Republic','el-salvador':'El Salvador',
  'estonia':'Estonia','ghana':'Ghana','honduras':'Honduras','jamaica':'Jamaica',
  'kazakhstan':'Kazakhstan','latvia':'Latvia','lithuania':'Lithuania',
  'malta':'Malta','montenegro':'Montenegro','nepal':'Nepal',
  'nicaragua':'Nicaragua','north-macedonia':'North Macedonia','paraguay':'Paraguay',
  'rwanda':'Rwanda','slovakia':'Slovakia','slovenia':'Slovenia',
  'south-africa':'South Africa','taiwan':'Taiwan','turkey':'Turkey','uruguay':'Uruguay',
};
const ISO2: Record<string,string> = {
  'portugal':'pt','spain':'es','poland':'pl','mexico':'mx','thailand':'th',
  'germany':'de','japan':'jp','croatia':'hr','czech-republic':'cz','hungary':'hu',
  'romania':'ro','bulgaria':'bg','vietnam':'vn','south-korea':'kr','australia':'au',
  'new-zealand':'nz','canada':'ca','ireland':'ie','netherlands':'nl','france':'fr',
  'argentina':'ar','ecuador':'ec','morocco':'ma','switzerland':'ch','norway':'no',
  'denmark':'dk','sweden':'se','belgium':'be','austria':'at','finland':'fi',
  'united-kingdom':'gb','singapore':'sg','united-arab-emirates':'ae','qatar':'qa',
  'saudi-arabia':'sa','iceland':'is','india':'in','philippines':'ph','china':'cn',
  'georgia':'ge','serbia':'rs','kenya':'ke','peru':'pe','brazil':'br','chile':'cl',
  'albania':'al','sri-lanka':'lk','egypt':'eg','indonesia':'id','colombia':'co',
  'costa-rica':'cr','panama':'pa','malaysia':'my','italy':'it','greece':'gr',
  'bahamas':'bs','belize':'bz','bolivia':'bo','cambodia':'kh','cyprus':'cy',
  'dominican-republic':'do','el-salvador':'sv','estonia':'ee','ghana':'gh',
  'honduras':'hn','jamaica':'jm','kazakhstan':'kz','latvia':'lv','lithuania':'lt',
  'malta':'mt','montenegro':'me','nepal':'np','nicaragua':'ni',
  'north-macedonia':'mk','paraguay':'py','rwanda':'rw','slovakia':'sk',
  'slovenia':'si','south-africa':'za','taiwan':'tw','turkey':'tr','uruguay':'uy',
};

const qs = qualityScoresData.countries as Record<string, any>;
const all = Object.entries(qs);

type Row = {
  slug: string; name: string; iso2: string;
  single: number; couple: number; tax: string;
  visa: number | null; nomad: boolean; health: number; safety: number;
  y100: number;
};
const rows: Row[] = all
  .filter(([slug, d]) => d.budget_single && d.budget_couple && NAMES[slug] && ISO2[slug])
  .map(([slug, d]) => ({
    slug, name: NAMES[slug], iso2: ISO2[slug],
    single: d.budget_single as number, couple: d.budget_couple as number,
    tax: d.tax_system || 'unknown',
    visa: typeof d.visa_days === 'number' ? d.visa_days : null,
    nomad: !!d.nomad_visa,
    health: d.healthcare as number, safety: d.safety as number,
    y100: +(100000 / (d.budget_single as number) / 12).toFixed(1),
  }));

const countryCount = rows.length;
const US_MONTHLY = 3500;
const usYears100k = +(100000 / US_MONTHLY / 12).toFixed(1);

/* ── 1. VISA TRAP: money outlasts legal welcome ── */
const visaTrap = rows
  .filter(r => r.visa !== null && r.visa <= 90 && !r.nomad && r.y100 >= 4)
  .sort((a, b) => b.y100 - a.y100);
const trapMax = visaTrap.length ? visaTrap[0].y100 : 0;
const thirtyDayCount = rows.filter(r => r.visa === 30).length;
const nomadCount = rows.filter(r => r.nomad).length;

/* ── 2. INCOME THRESHOLD: how little earned makes it permanent ── */
const THRESHOLDS = [750, 1000, 1250, 1500, 2000, 2500, 3000, 3500];
const incomeCurve = THRESHOLDS.map(t => {
  const n = rows.filter(r => r.single <= t).length;
  return { amount: t, count: n, pct: Math.round((n / countryCount) * 100) };
});
const at1000 = incomeCurve.find(x => x.amount === 1000)!;
const at2000 = incomeCurve.find(x => x.amount === 2000)!;
const at3000 = incomeCurve.find(x => x.amount === 3000)!;
const curveMax = Math.max(...incomeCurve.map(x => x.count));

/* ── 3. CHEAP AND LIVABLE: runway that survives a quality filter ── */
const RUNWAY_MIN = 5, QUALITY_MIN = 7;
const cheapLivable = rows
  .filter(r => r.y100 >= RUNWAY_MIN && r.health >= QUALITY_MIN && r.safety >= QUALITY_MIN)
  .sort((a, b) => b.y100 - a.y100);
const clMax = cheapLivable.length ? cheapLivable[0].y100 : 0;
const failsQuality = rows
  .filter(r => r.y100 >= 7 && (r.safety <= 4 || r.health <= 5))
  .sort((a, b) => b.y100 - a.y100);

/* ── 4. CITY-LEVEL DATA ── */
type City = { city: string; country: string; iso2: string; slug: string; cost: number; years: number };
const cities: City[] = [];
for (const [slug, d] of all) {
  if (!NAMES[slug] || !ISO2[slug] || !Array.isArray(d.affordable_cities)) continue;
  for (const c of d.affordable_cities) {
    if (!c || typeof c.monthly_usd !== 'number') continue;
    cities.push({
      city: c.name, country: NAMES[slug], iso2: ISO2[slug], slug,
      cost: c.monthly_usd, years: +(100000 / c.monthly_usd / 12).toFixed(1),
    });
  }
}
cities.sort((a, b) => a.cost - b.cost);
const cityCount = cities.length;
const cheapestCity = cities[0];

/* ── 5. FULL DATASET TABLE ── */
const tableRows = [...rows].sort((a, b) => b.y100 - a.y100);

const updated = 'July 2026';

const datasetSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '2026 Runway Report: Savings Runway, Visa Limits and Livability by Country',
  description: `How long $100,000 in savings lasts across ${countryCount} countries and ${cityCount} cities, cross-referenced against visa-free stay limits, healthcare and safety scores, and the monthly income needed to make savings last indefinitely.`,
  url: 'https://leavingamerica.co/statistics/2026-runway-report/',
  creator: { '@type': 'Organization', name: 'LeavingAmerica.co', url: 'https://leavingamerica.co' },
  dateModified: qualityScoresData.lastUpdated,
  license: 'https://leavingamerica.co/methodology/',
  variableMeasured: [
    'Monthly cost of living (USD, single person)',
    'Monthly cost of living by city (USD)',
    'Savings runway in years at $100,000',
    'Visa-free stay length (days)',
    'Digital nomad visa availability',
    'Healthcare quality score (0-10)',
    'Safety score (0-10)',
    'Monthly income required to cover full local cost of living',
  ],
});
---

<BaseLayout
  title="2026 Runway Report: Savings, Visa Limits & Livability Abroad"
  description={`How long $100,000 lasts across ${countryCount} countries and ${cityCount} cities, cross-referenced against visa-free stay limits, healthcare and safety scores, and the income that makes savings permanent. Citable data for journalists.`}
  ogTitle="2026 Runway Report: What Americans Can Afford, and Where They Can Stay"
>
  <script type="application/ld+json" set:html={datasetSchema} />

<style is:global>
:root { --rwr-ease: cubic-bezier(0.22, 1, 0.36, 1); }

/* ═══ HERO ═══ */
.rwr-hero {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, #0a1120 0%, #10203f 48%, #0b1830 100%);
  color: #fff; padding: 92px 0 78px; text-align: center;
}
.rwr-orb { position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none; }
.rwr-orb-1 { width: 640px; height: 640px; background: #2563eb; opacity: 0.42; top: -220px; left: -120px; }
.rwr-orb-2 { width: 520px; height: 520px; background: #0891b2; opacity: 0.34; bottom: -180px; right: -120px; }
.rwr-dots {
  position: absolute; inset: 0;
  background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
  background-size: 30px 30px; pointer-events: none;
  mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, #000 40%, transparent 100%);
  -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, #000 40%, transparent 100%);
}
.rwr-hero-inner { max-width: 900px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 1; }
.rwr-pill {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 6px 16px; background: rgba(59,130,246,0.16);
  border: 1px solid rgba(96,165,250,0.35); border-radius: 30px;
  font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  color: #93c5fd; margin-bottom: 24px;
}
.rwr-pill-dot { width: 7px; height: 7px; border-radius: 50%; background: #34d399; box-shadow: 0 0 0 0 rgba(52,211,153,0.7); animation: rwr-pulse 2s infinite; }
@keyframes rwr-pulse { 0% { box-shadow: 0 0 0 0 rgba(52,211,153,0.6); } 70% { box-shadow: 0 0 0 8px rgba(52,211,153,0); } 100% { box-shadow: 0 0 0 0 rgba(52,211,153,0); } }
.rwr-hero h1 {
  font-size: clamp(28px, 5vw, 50px); font-weight: 800; letter-spacing: -0.03em;
  line-height: 1.1; margin: 0 0 18px;
  background: linear-gradient(180deg, #ffffff 0%, #bcd2f5 100%);
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
.rwr-hero-sub { font-size: clamp(15px, 2.1vw, 18px); color: rgba(255,255,255,0.66); max-width: 640px; margin: 0 auto; line-height: 1.6; }
.rwr-hero-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 46px; }
.rwr-hs { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 22px 14px 18px; backdrop-filter: blur(8px); }
.rwr-hs-num { font-size: clamp(24px, 3.4vw, 36px); font-weight: 800; letter-spacing: -0.02em; line-height: 1; color: #fff; }
.rwr-hs-num.grad { background: linear-gradient(120deg, #60a5fa, #22d3ee); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.rwr-hs-label { font-size: 12px; color: rgba(255,255,255,0.55); margin-top: 8px; line-height: 1.35; }
.rwr-meta { font-size: 13px; color: rgba(255,255,255,0.4); margin-top: 36px; }
.rwr-meta a { color: rgba(255,255,255,0.55); }

/* ═══ BODY ═══ */
.rwr-body { background: #f8fafc; }
.rwr-section { padding: 60px 0 12px; }
.rwr-section:last-of-type { padding-bottom: 72px; }
.rwr-wrap { max-width: 900px; margin: 0 auto; padding: 0 24px; }
.rwr-eyebrow { font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #2563eb; margin: 0 0 8px; }
.rwr-section h2 { font-size: clamp(21px, 3.2vw, 30px); font-weight: 800; color: #0f172a; letter-spacing: -0.02em; margin: 0 0 6px; line-height: 1.2; }
.rwr-section-sub { font-size: 14px; color: #64748b; margin: 0 0 28px; max-width: 640px; }

.rwr-reveal { opacity: 0; transform: translateY(22px); transition: opacity 0.7s var(--rwr-ease), transform 0.7s var(--rwr-ease); }
.rwr-reveal.in { opacity: 1; transform: none; }

/* ═══ KEY FINDINGS ═══ */
.rwr-kf-list { list-style: none; margin: 0; padding: 0; counter-reset: rwr-kf; display: flex; flex-direction: column; gap: 14px; }
.rwr-kf-item {
  counter-increment: rwr-kf; position: relative;
  background: #fff; border: 1px solid #e6ebf2; border-radius: 14px;
  padding: 18px 20px 18px 58px; font-size: 14.5px; color: #334155; line-height: 1.65;
}
.rwr-kf-item::before {
  content: counter(rwr-kf); position: absolute; left: 18px; top: 18px;
  width: 26px; height: 26px; border-radius: 8px;
  background: linear-gradient(135deg, #2563eb, #22d3ee); color: #fff;
  font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center;
}
.rwr-kf-item strong { color: #0f172a; }

/* CTA / cite */
.rwr-cta { background: linear-gradient(135deg, #eff6ff, #eef2ff); border: 1px solid #dbe4fb; border-radius: 16px; padding: 20px 24px; margin-top: 30px; font-size: 14px; color: #334155; line-height: 1.6; }
.rwr-cta a { color: #2563eb; font-weight: 700; text-decoration: none; }
.rwr-cta a:hover { text-decoration: underline; }
.rwr-cite { background: #0f1e38; color: #cbd9f0; border-radius: 16px; padding: 24px 26px; font-size: 14px; line-height: 1.65; margin-top: 40px; }
.rwr-cite strong { color: #fff; }
.rwr-cite a { color: #7dd3fc; }

/* ═══ BAR CHART ═══ */
.rwr-chart { background: #fff; border: 1px solid #e6ebf2; border-radius: 18px; padding: 26px 26px 22px; }
.rwr-bar-row { display: grid; grid-template-columns: 148px 1fr auto; align-items: center; gap: 14px; padding: 9px 0; }
.rwr-bar-label { display: flex; align-items: center; gap: 9px; font-size: 13.5px; font-weight: 600; color: #1e293b; min-width: 0; }
.rwr-bar-label .fi { width: 22px; height: 16px; border-radius: 3px; flex-shrink: 0; box-shadow: 0 0 0 1px rgba(0,0,0,0.12); }
.rwr-bar-label span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rwr-bar-track { height: 26px; background: #f1f5f9; border-radius: 8px; overflow: hidden; }
.rwr-bar-fill { height: 100%; width: 0; border-radius: 8px; transition: width 1.1s var(--rwr-ease); }
.rwr-bar-fill.green { background: linear-gradient(90deg, #10b981, #34d399); }
.rwr-bar-fill.blue { background: linear-gradient(90deg, #2563eb, #22d3ee); }
.rwr-bar-fill.amber { background: linear-gradient(90deg, #b45309, #f59e0b); }
.rwr-bar-val { font-size: 13.5px; font-weight: 800; color: #0f172a; white-space: nowrap; }
.rwr-chart-note { font-size: 12.5px; color: #94a3b8; margin: 16px 0 0; }

/* ═══ QUALITY BADGE / WARN ═══ */
.rwr-qbadge {
  display: inline-block; margin-left: 6px; padding: 2px 7px;
  background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 20px;
  font-size: 11px; font-weight: 700; color: #047857; letter-spacing: 0.02em;
}
.rwr-table .rwr-warn { color: #b91c1c; font-weight: 800; }
.rwr-warnbox {
  background: #fff7ed; border: 1px solid #fed7aa; border-radius: 16px;
  padding: 20px 24px; margin-top: 24px; font-size: 14px; color: #7c2d12; line-height: 1.65;
}
.rwr-warnbox strong { display: block; color: #7c2d12; margin-bottom: 10px; }
.rwr-warnbox ul { margin: 0; padding-left: 20px; }
.rwr-warnbox li { margin-bottom: 5px; }
.rwr-tall { max-height: 520px; overflow-y: auto; }

/* ═══ METHODOLOGY ═══ */
.rwr-meth { background: #fff; border: 1px solid #e6ebf2; border-radius: 16px; padding: 24px 26px; }
.rwr-meth p { font-size: 14px; color: #334155; line-height: 1.75; margin: 0 0 14px; }
.rwr-meth p:last-child { margin-bottom: 0; }
.rwr-meth code { background: #f1f5f9; padding: 2px 6px; border-radius: 6px; font-size: 13px; }

/* ═══ FULL TABLE ═══ */
.rwr-table-tools { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
.rwr-search { position: relative; flex: 1; min-width: 220px; }
.rwr-search input {
  width: 100%; padding: 11px 14px 11px 38px; font-size: 14px; font-family: inherit;
  border: 1.5px solid #cbd5e1; border-radius: 10px; outline: none; box-sizing: border-box; color: #0f172a;
  transition: border-color 0.15s, box-shadow 0.15s; background: #fff;
}
.rwr-search input:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.12); }
.rwr-search svg { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: #94a3b8; }
.rwr-search-count { font-size: 13px; color: #94a3b8; white-space: nowrap; }
.rwr-scroll-hint { display: none; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 700; color: #2563eb; margin: 0 0 10px; }
.rwr-scroll-hint.show { display: inline-flex; }
.rwr-scroll-hint svg { animation: rwr-swipe 1.5s ease-in-out infinite; }
@keyframes rwr-swipe { 0%, 100% { transform: translateX(0); opacity: 0.55; } 50% { transform: translateX(4px); opacity: 1; } }
.rwr-table-scroll { position: relative; overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid #e6ebf2; border-radius: 14px; background: #fff; }
.rwr-table-fade {
  position: absolute; top: 0; right: 0; bottom: 0; width: 40px;
  background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,0.97));
  pointer-events: none; border-radius: 0 14px 14px 0; opacity: 0; transition: opacity 0.25s ease;
}
.rwr-table-fade.show { opacity: 1; }
table.rwr-table { width: 100%; border-collapse: collapse; font-size: 13.5px; min-width: 560px; }
.rwr-table thead th { position: sticky; top: 0; background: #0f1e38; color: #cbd9f0; font-weight: 700; text-align: left; padding: 13px 16px; font-size: 12px; letter-spacing: 0.02em; white-space: nowrap; }
.rwr-table thead th.num { text-align: right; }
.rwr-table tbody td { padding: 11px 16px; border-top: 1px solid #eef2f7; color: #334155; }
.rwr-table tbody td.num { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; color: #0f172a; }
.rwr-table tbody tr:hover { background: #f8fafc; }
.rwr-table tbody tr:nth-child(even) { background: #fcfdff; }
.rwr-table tbody tr:nth-child(even):hover { background: #f8fafc; }
.rwr-tc-name { display: flex; align-items: center; gap: 10px; }
.rwr-tc-name a { color: #1e293b; text-decoration: none; font-weight: 600; }
.rwr-tc-name a:hover { color: #2563eb; }
.rwr-tc-name .fi { width: 22px; height: 16px; border-radius: 3px; flex-shrink: 0; box-shadow: 0 0 0 1px rgba(0,0,0,0.12); }
.rwr-noresults { display: none; text-align: center; padding: 32px; color: #94a3b8; font-size: 14px; }

@media (max-width: 720px) {
  .rwr-hero-stats { grid-template-columns: 1fr 1fr; }
  .rwr-bar-row { grid-template-columns: 118px 1fr auto; gap: 10px; }
  .rwr-bar-label { font-size: 12.5px; }
  .rwr-kf-item { padding-left: 52px; }
}
@media (prefers-reduced-motion: reduce) {
  .rwr-reveal { opacity: 1; transform: none; transition: none; }
  .rwr-bar-fill { transition: none; }
  .rwr-pill-dot { animation: none; }
}
</style>

<!-- HERO -->
<section class="rwr-hero">
  <div class="rwr-orb rwr-orb-1"></div>
  <div class="rwr-orb rwr-orb-2"></div>
  <div class="rwr-dots"></div>
  <div class="rwr-hero-inner">
    <span class="rwr-pill"><span class="rwr-pill-dot"></span>Live data · {countryCount} countries · {cityCount} cities · Free to cite</span>
    <h1>2026 Runway Report:<br/>What Americans Can Afford, and Where They Can Actually Stay</h1>
    <p class="rwr-hero-sub">Cost of living is the easy half. This report cross-references how long savings last against how long you may legally remain, how little income makes the math permanent, and which cheap countries survive a healthcare and safety filter.</p>
    <div class="rwr-hero-stats">
      <div class="rwr-hs"><div class="rwr-hs-num grad" data-count={trapMax} data-suffix=" yrs">0</div><div class="rwr-hs-label">runway in {visaTrap.length ? visaTrap[0].name : ''} on $100K, against {visaTrap.length ? visaTrap[0].visa : 0} days of legal stay</div></div>
      <div class="rwr-hs"><div class="rwr-hs-num" data-count={at2000.count} data-suffix={`/${countryCount}`}>0</div><div class="rwr-hs-label">countries fully covered by $2,000/mo of income</div></div>
      <div class="rwr-hs"><div class="rwr-hs-num grad" data-count={cheapLivable.length} data-suffix={`/${countryCount}`}>0</div><div class="rwr-hs-label">combine 5+ yr runway with good healthcare and safety</div></div>
      <div class="rwr-hs"><div class="rwr-hs-num" data-count={cheapestCity.cost} data-prefix="$">0</div><div class="rwr-hs-label">cheapest tracked city ({cheapestCity.city})</div></div>
    </div>
    <p class="rwr-meta">Computed live from the LeavingAmerica.co dataset · Updated {updated} · <a href="/methodology/">Methodology</a></p>
  </div>
</section>

<div class="rwr-body">

  <!-- KEY FINDINGS -->
  <section class="rwr-section">
    <div class="rwr-wrap">
      <p class="rwr-eyebrow rwr-reveal">Key Findings</p>
      <h2 class="rwr-reveal">Six Numbers Worth Quoting</h2>
      <p class="rwr-section-sub rwr-reveal">Free to cite in articles, newsletters, and research with attribution and a link to this page.</p>
      <ol class="rwr-kf-list rwr-reveal">
        <li class="rwr-kf-item"><strong>In {visaTrap[0].name}, $100,000 covers {visaTrap[0].y100} years of living costs and the visa runs out after {visaTrap[0].visa} days.</strong> Affordability and legal access are separate problems, and almost nobody publishes them side by side.</li>
        <li class="rwr-kf-item"><strong>{thirtyDayCount} of {countryCount} tracked countries admit Americans for just 30 days visa-free,</strong> and only {nomadCount} offer a digital nomad visa as a longer-term route. For the remaining {countryCount - nomadCount}, staying means employment, investment, ancestry, or repeated border runs.</li>
        <li class="rwr-kf-item"><strong>$2,000 a month in remote income fully covers local costs in {at2000.count} of {countryCount} countries ({at2000.pct}%).</strong> At $1,000 the number is {at1000.count}; at $3,000 it reaches {at3000.count}. Framed this way, the question stops being how much you saved and becomes how little you need to earn.</li>
        <li class="rwr-kf-item"><strong>Only {cheapLivable.length} of {countryCount} countries combine five or more years of runway with healthcare and safety scores of 7 or better.</strong> {cheapLivable[0].name} leads at {cheapLivable[0].y100} years, followed by {cheapLivable[1].name} and {cheapLivable[2].name}. Cheap and livable overlap far less than cost tables suggest.</li>
        <li class="rwr-kf-item"><strong>The longest runways often fail that filter.</strong> {failsQuality[0].name} offers {failsQuality[0].y100} years but scores {failsQuality[0].safety} of 10 on safety; {failsQuality[1].name} offers {failsQuality[1].y100} years at a safety score of {failsQuality[1].safety}.</li>
        <li class="rwr-kf-item"><strong>{cheapestCity.city}, {cheapestCity.country} is the cheapest of {cityCount} tracked cities at ${cheapestCity.cost} a month,</strong> which turns $100,000 into {cheapestCity.years} years. City-level figures diverge sharply from national averages, and the averages are what most coverage uses.</li>
      </ol>
    </div>
  </section>

  <!-- VISA TRAP -->
  <section class="rwr-section">
    <div class="rwr-wrap">
      <p class="rwr-eyebrow rwr-reveal">Finding 1</p>
      <h2 class="rwr-reveal">Where Your Money Outlasts Your Welcome</h2>
      <p class="rwr-section-sub rwr-reveal">Countries offering at least four years of runway on $100,000, no digital nomad visa, and 90 or fewer visa-free days. The gap between the two columns is the part cost-of-living rankings never show.</p>
      <div class="rwr-table-scroll rwr-reveal" id="rwr-trap-scroll">
        <table class="rwr-table">
          <thead>
            <tr>
              <th>Country</th>
              <th class="num">Runway on $100K</th>
              <th class="num">Visa-free stay</th>
              <th class="num">Monthly cost</th>
            </tr>
          </thead>
          <tbody>
            {visaTrap.map(r => (
              <tr>
                <td><span class="rwr-tc-name"><span class={`fi fi-${r.iso2}`}></span><a href={`/countries/${r.slug}/`}>{r.name}</a></span></td>
                <td class="num">{r.y100} yrs</td>
                <td class="num rwr-warn">{r.visa} days</td>
                <td class="num">${r.single.toLocaleString()}/mo</td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="rwr-table-fade" id="rwr-trap-fade" aria-hidden="true"></div>
      </div>
      <p class="rwr-chart-note">Visa-free entry is not residency. Extensions, border runs, and long-stay permits exist in most of these countries, but each carries its own income thresholds, paperwork, and refusal risk. Anyone budgeting a multi-year stay should treat the legal pathway as the binding constraint, not the money.</p>
    </div>
  </section>

  <!-- INCOME THRESHOLD -->
  <section class="rwr-section">
    <div class="rwr-wrap">
      <p class="rwr-eyebrow rwr-reveal">Finding 2</p>
      <h2 class="rwr-reveal">How Little Income Makes Savings Permanent</h2>
      <p class="rwr-section-sub rwr-reveal">Savings only deplete when spending exceeds income. This chart counts how many of the {countryCount} tracked countries a given monthly income covers outright, at which point the runway stops being finite.</p>
      <div class="rwr-chart rwr-reveal">
        {incomeCurve.map(x => (
          <div class="rwr-bar-row">
            <div class="rwr-bar-label"><span>${x.amount.toLocaleString()}/mo</span></div>
            <div class="rwr-bar-track"><div class="rwr-bar-fill blue" data-bar={Math.round((x.count / curveMax) * 100)}></div></div>
            <div class="rwr-bar-val">{x.count} countries</div>
          </div>
        ))}
        <p class="rwr-chart-note">A part-time remote income of $1,000 a month, roughly one freelance client, covers full local costs in {at1000.count} countries outright. The same figure buys about a third of average rent in a mid-cost US city.</p>
      </div>
      <div class="rwr-cta rwr-reveal">Model your own income and lifestyle level against every country in the <a href="/runway/">Runway Calculator</a>.</div>
    </div>
  </section>

  <!-- CHEAP AND LIVABLE -->
  <section class="rwr-section">
    <div class="rwr-wrap">
      <p class="rwr-eyebrow rwr-reveal">Finding 3</p>
      <h2 class="rwr-reveal">Cheap That Survives a Quality Filter</h2>
      <p class="rwr-section-sub rwr-reveal">The {cheapLivable.length} countries clearing five or more years of runway on $100,000 while also scoring 7 or better on both healthcare and safety. This ranking differs substantially from a pure cost ranking.</p>
      <div class="rwr-chart rwr-reveal">
        {cheapLivable.map(r => (
          <div class="rwr-bar-row">
            <div class="rwr-bar-label"><span class={`fi fi-${r.iso2}`}></span><span>{r.name}</span></div>
            <div class="rwr-bar-track"><div class="rwr-bar-fill green" data-bar={Math.round((r.y100 / clMax) * 100)}></div></div>
            <div class="rwr-bar-val">{r.y100} yrs <span class="rwr-qbadge">H{r.health} S{r.safety}</span></div>
          </div>
        ))}
        <p class="rwr-chart-note">H = healthcare quality, S = safety, each scored 0 to 10. Sources for both are listed on the <a href="/methodology/">methodology page</a>.</p>
      </div>
      <div class="rwr-warnbox rwr-reveal">
        <strong>The countries that fail this filter are the ones cost rankings put first.</strong>
        <ul>
          {failsQuality.map(r => (
            <li>{r.name}: {r.y100} years of runway, healthcare {r.health}/10, safety {r.safety}/10</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- CITIES -->
  <section class="rwr-section">
    <div class="rwr-wrap">
      <p class="rwr-eyebrow rwr-reveal">Finding 4</p>
      <h2 class="rwr-reveal">National Averages Hide the Real Numbers</h2>
      <p class="rwr-section-sub rwr-reveal">Monthly cost and $100,000 runway for {cityCount} cities across {countryCount} countries, cheapest first. Most coverage of this topic quotes country averages, which sit well above what specific cities actually cost.</p>
      <div class="rwr-table-tools rwr-reveal">
        <div class="rwr-search">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.6"/><path d="M11 11l3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <input type="text" id="rwr-city-search" placeholder="Search a city or country…" aria-label="Search cities" />
        </div>
        <span class="rwr-search-count" id="rwr-city-count">{cityCount} cities</span>
      </div>
      <div class="rwr-table-scroll rwr-reveal rwr-tall" id="rwr-city-scroll">
        <table class="rwr-table">
          <thead>
            <tr>
              <th>City</th>
              <th>Country</th>
              <th class="num">Monthly cost</th>
              <th class="num">Runway on $100K</th>
            </tr>
          </thead>
          <tbody id="rwr-city-body">
            {cities.map(c => (
              <tr data-name={`${c.city} ${c.country}`.toLowerCase()}>
                <td>{c.city}</td>
                <td><span class="rwr-tc-name"><span class={`fi fi-${c.iso2}`}></span><a href={`/countries/${c.slug}/`}>{c.country}</a></span></td>
                <td class="num">${c.cost.toLocaleString()}/mo</td>
                <td class="num">{c.years} yrs</td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="rwr-noresults" id="rwr-city-none">No city matches that search.</div>
        <div class="rwr-table-fade" id="rwr-city-fade" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- FULL TABLE -->
  <section class="rwr-section">
    <div class="rwr-wrap">
      <p class="rwr-eyebrow rwr-reveal">The Full Dataset</p>
      <h2 class="rwr-reveal">Every Tracked Country, All Four Variables</h2>
      <p class="rwr-section-sub rwr-reveal">Monthly cost, runway on $100,000, visa-free days, nomad visa availability, and healthcare and safety scores for all {countryCount} countries. Sorted by runway, longest first.</p>
      <div class="rwr-table-tools rwr-reveal">
        <div class="rwr-search">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.6"/><path d="M11 11l3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <input type="text" id="rwr-tbl-search" placeholder="Search a country…" aria-label="Search countries" />
        </div>
        <span class="rwr-search-count" id="rwr-tbl-count">{countryCount} countries</span>
      </div>
      <p class="rwr-scroll-hint" id="rwr-scroll-hint">
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M2 7.5h11M9 4l4 3.5-4 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Swipe to see all columns
      </p>
      <div class="rwr-table-scroll rwr-reveal" id="rwr-table-scroll">
        <table class="rwr-table">
          <thead>
            <tr>
              <th>Country</th>
              <th class="num">Monthly cost</th>
              <th class="num">Runway $100K</th>
              <th class="num">Visa-free</th>
              <th class="num">Nomad visa</th>
              <th class="num">Health</th>
              <th class="num">Safety</th>
            </tr>
          </thead>
          <tbody id="rwr-tbl-body">
            {tableRows.map(r => (
              <tr data-name={r.name.toLowerCase()}>
                <td><span class="rwr-tc-name"><span class={`fi fi-${r.iso2}`}></span><a href={`/countries/${r.slug}/`}>{r.name}</a></span></td>
                <td class="num">${r.single.toLocaleString()}/mo</td>
                <td class="num">{r.y100} yrs</td>
                <td class="num">{r.visa === null ? 'n/a' : `${r.visa} d`}</td>
                <td class="num">{r.nomad ? 'yes' : 'no'}</td>
                <td class="num">{r.health}/10</td>
                <td class="num">{r.safety}/10</td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="rwr-noresults" id="rwr-tbl-none">No country matches that search.</div>
        <div class="rwr-table-fade" id="rwr-table-fade" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- METHODOLOGY -->
  <section class="rwr-section">
    <div class="rwr-wrap">
      <p class="rwr-eyebrow rwr-reveal">Methodology</p>
      <h2 class="rwr-reveal">How This Was Calculated</h2>
      <div class="rwr-meth rwr-reveal">
        <p>Runway in years is calculated as <code>savings ÷ monthly cost of living ÷ 12</code>, using each country's baseline single-person monthly cost, and the same formula against city-level costs where available. Cost figures come from a public open-data cost-of-living API and are refreshed quarterly. The income threshold in Finding 2 is simply that monthly cost figure read the other way: income at or above it covers spending outright, so savings stop depleting.</p>
        <p>Healthcare and safety scores run 0 to 10, derived from the UHC Service Coverage Index and the Global Peace Index respectively. Visa-free stay lengths reflect standard tourist entry for US passport holders and exclude extensions, border runs, and long-stay permits. Digital nomad visa availability is a yes/no flag for whether a formal remote-worker route exists, not a judgment on how accessible it is. Every source is named in full on the <a href="/methodology/">methodology page</a>.</p>
        <p>Runway figures assume no additional income and a constant cost of living at a normal (non-lean, non-luxury) standard. The interactive <a href="/runway/">Runway Calculator</a> lets you set your own income and lifestyle level.</p>
        <p>Figures exclude one-time relocation costs, healthcare premiums, currency risk, and US tax obligations, which apply to citizens regardless of residence. Visa rules change frequently and should be verified against the relevant consulate before any decision. This report reflects data current as of {updated}.</p>
      </div>

      <div class="rwr-cite rwr-reveal">
        <strong>Citing this report:</strong> every figure here is free to use in articles, newsletters, and research with attribution and a link to this page. Journalists can reach me for custom numbers on any country or savings amount: <a href="mailto:contact@leavingamerica.co">contact@leavingamerica.co</a>.
      </div>
    </div>
  </section>

</div>

<script>
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var revEls = Array.prototype.slice.call(document.querySelectorAll('.rwr-reveal'));
  if (reduce) {
    revEls.forEach(function (el) { el.classList.add('in'); });
  } else {
    var revObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); revObs.unobserve(e.target); } });
    }, { threshold: 0.12 });
    revEls.forEach(function (el) { revObs.observe(el); });
  }

  function fmt(n) {
    return (Math.round(n * 10) / 10).toLocaleString('en-US', { minimumFractionDigits: n % 1 !== 0 ? 1 : 0, maximumFractionDigits: 1 });
  }
  function animateCount(el) {
    var target = parseFloat(el.getAttribute('data-count')) || 0;
    var prefix = el.getAttribute('data-prefix') || '';
    var suffix = el.getAttribute('data-suffix') || '';
    if (reduce) { el.textContent = prefix + fmt(target) + suffix; return; }
    var dur = 1300, start = null;
    function step(ts) {
      if (!start) start = ts;
      var p = Math.min((ts - start) / dur, 1);
      var eased = 1 - Math.pow(1 - p, 3);
      el.textContent = prefix + fmt(target * eased) + suffix;
      if (p < 1) requestAnimationFrame(step);
      else el.textContent = prefix + fmt(target) + suffix;
    }
    requestAnimationFrame(step);
  }
  var countEls = Array.prototype.slice.call(document.querySelectorAll('[data-count]'));
  var countObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) { animateCount(e.target); countObs.unobserve(e.target); } });
  }, { threshold: 0.6 });
  countEls.forEach(function (el) { countObs.observe(el); });

  var barEls = Array.prototype.slice.call(document.querySelectorAll('[data-bar]'));
  function fillBar(el) {
    var w = el.getAttribute('data-bar') + '%';
    if (reduce) { el.style.width = w; return; }
    requestAnimationFrame(function () { el.style.width = w; });
  }
  var barObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) { fillBar(e.target); barObs.unobserve(e.target); } });
  }, { threshold: 0.4 });
  barEls.forEach(function (el) { barObs.observe(el); });

  function wireSearch(inputId, bodyId, countId, noneId, singular, plural) {
    var input = document.getElementById(inputId);
    var body = document.getElementById(bodyId);
    if (!input || !body) return;
    var trs = Array.prototype.slice.call(body.querySelectorAll('tr'));
    var countEl2 = document.getElementById(countId);
    var noneEl2 = document.getElementById(noneId);
    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      var shown = 0;
      trs.forEach(function (tr) {
        var match = (tr.getAttribute('data-name') || '').indexOf(q) !== -1;
        tr.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      if (countEl2) countEl2.textContent = shown + ' ' + (shown === 1 ? singular : plural);
      if (noneEl2) noneEl2.style.display = shown === 0 ? 'block' : 'none';
    });
  }
  wireSearch('rwr-tbl-search', 'rwr-tbl-body', 'rwr-tbl-count', 'rwr-tbl-none', 'country', 'countries');
  wireSearch('rwr-city-search', 'rwr-city-body', 'rwr-city-count', 'rwr-city-none', 'city', 'cities');

  function wireScroll(scrollId, fadeId, hintId) {
    var sc = document.getElementById(scrollId);
    var fade = document.getElementById(fadeId);
    if (!sc || !fade) return;
    var hint = hintId ? document.getElementById(hintId) : null;
    function update() {
      var hasOverflow = sc.scrollWidth > sc.clientWidth + 2;
      var atEnd = sc.scrollLeft + sc.clientWidth >= sc.scrollWidth - 4;
      fade.classList.toggle('show', hasOverflow && !atEnd);
      if (hint) hint.classList.toggle('show', hasOverflow);
    }
    update();
    sc.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
  wireScroll('rwr-table-scroll', 'rwr-table-fade', 'rwr-scroll-hint');
  wireScroll('rwr-trap-scroll', 'rwr-trap-fade', null);
  wireScroll('rwr-city-scroll', 'rwr-city-fade', null);
</script>

</BaseLayout>
