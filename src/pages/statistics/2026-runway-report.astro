---
import BaseLayout from '../../layouts/BaseLayout.astro';
import qualityScoresData from '../../data/quality-scores.json';

const NAMES: Record<string,string> = {
  'portugal':'Portugal','spain':'Spain','poland':'Poland','mexico':'Mexico',
  'thailand':'Thailand','germany':'Germany','japan':'Japan','croatia':'Croatia',
  'czech-republic':'Czech Republic','hungary':'Hungary','romania':'Romania',
  'bulgaria':'Bulgaria','vietnam':'Vietnam','south-korea':'South Korea',
  'australia':'Australia','new-zealand':'New Zealand','canada':'Canada',
  'ireland':'Ireland','netherlands':'Netherlands','france':'France',
  'argentina':'Argentina','ecuador':'Ecuador','morocco':'Morocco',
  'switzerland':'Switzerland','norway':'Norway','denmark':'Denmark',
  'sweden':'Sweden','belgium':'Belgium','austria':'Austria','finland':'Finland',
  'united-kingdom':'United Kingdom','singapore':'Singapore',
  'united-arab-emirates':'UAE','qatar':'Qatar','saudi-arabia':'Saudi Arabia',
  'iceland':'Iceland','india':'India','philippines':'Philippines','china':'China',
  'georgia':'Georgia','serbia':'Serbia','kenya':'Kenya','peru':'Peru',
  'brazil':'Brazil','chile':'Chile','albania':'Albania','sri-lanka':'Sri Lanka',
  'egypt':'Egypt','indonesia':'Indonesia','colombia':'Colombia',
  'costa-rica':'Costa Rica','panama':'Panama','malaysia':'Malaysia',
  'italy':'Italy','greece':'Greece','bahamas':'Bahamas','belize':'Belize',
  'bolivia':'Bolivia','cambodia':'Cambodia','cyprus':'Cyprus',
  'dominican-republic':'Dominican Republic','el-salvador':'El Salvador',
  'estonia':'Estonia','ghana':'Ghana','honduras':'Honduras','jamaica':'Jamaica',
  'kazakhstan':'Kazakhstan','latvia':'Latvia','lithuania':'Lithuania',
  'malta':'Malta','montenegro':'Montenegro','nepal':'Nepal',
  'nicaragua':'Nicaragua','north-macedonia':'North Macedonia','paraguay':'Paraguay',
  'rwanda':'Rwanda','slovakia':'Slovakia','slovenia':'Slovenia',
  'south-africa':'South Africa','taiwan':'Taiwan','turkey':'Turkey','uruguay':'Uruguay',
};
const ISO2: Record<string,string> = {
  'portugal':'pt','spain':'es','poland':'pl','mexico':'mx','thailand':'th',
  'germany':'de','japan':'jp','croatia':'hr','czech-republic':'cz','hungary':'hu',
  'romania':'ro','bulgaria':'bg','vietnam':'vn','south-korea':'kr','australia':'au',
  'new-zealand':'nz','canada':'ca','ireland':'ie','netherlands':'nl','france':'fr',
  'argentina':'ar','ecuador':'ec','morocco':'ma','switzerland':'ch','norway':'no',
  'denmark':'dk','sweden':'se','belgium':'be','austria':'at','finland':'fi',
  'united-kingdom':'gb','singapore':'sg','united-arab-emirates':'ae','qatar':'qa',
  'saudi-arabia':'sa','iceland':'is','india':'in','philippines':'ph','china':'cn',
  'georgia':'ge','serbia':'rs','kenya':'ke','peru':'pe','brazil':'br','chile':'cl',
  'albania':'al','sri-lanka':'lk','egypt':'eg','indonesia':'id','colombia':'co',
  'costa-rica':'cr','panama':'pa','malaysia':'my','italy':'it','greece':'gr',
  'bahamas':'bs','belize':'bz','bolivia':'bo','cambodia':'kh','cyprus':'cy',
  'dominican-republic':'do','el-salvador':'sv','estonia':'ee','ghana':'gh',
  'honduras':'hn','jamaica':'jm','kazakhstan':'kz','latvia':'lv','lithuania':'lt',
  'malta':'mt','montenegro':'me','nepal':'np','nicaragua':'ni',
  'north-macedonia':'mk','paraguay':'py','rwanda':'rw','slovakia':'sk',
  'slovenia':'si','south-africa':'za','taiwan':'tw','turkey':'tr','uruguay':'uy',
};

const qs = qualityScoresData.countries as Record<string, any>;
const all = Object.entries(qs);

type Row = { slug: string; name: string; iso2: string; single: number; couple: number; tax: string };
const rows: Row[] = all
  .filter(([slug, d]) => d.budget_single && d.budget_couple && NAMES[slug] && ISO2[slug])
  .map(([slug, d]) => ({
    slug, name: NAMES[slug], iso2: ISO2[slug],
    single: d.budget_single as number, couple: d.budget_couple as number,
    tax: d.tax_system || 'unknown',
  }));

const countryCount = rows.length;
const US_MONTHLY = 3500;
const yrs = (amount: number, monthly: number) => amount / monthly / 12;

function tierData(amount: number) {
  const withYears = rows
    .map(r => ({ ...r, years: +(yrs(amount, r.single)).toFixed(1) }))
    .sort((a, b) => b.years - a.years);
  const avg = withYears.reduce((s, r) => s + r.years, 0) / withYears.length;
  return {
    amount,
    all: withYears,
    top12: withYears.slice(0, 12),
    longest: withYears[0],
    shortest: withYears[withYears.length - 1],
    avg: +avg.toFixed(1),
    usYears: +(yrs(amount, US_MONTHLY)).toFixed(1),
    over10: withYears.filter(r => r.years > 10).length,
  };
}

const t50 = tierData(50000);
const t100 = tierData(100000);
const t250 = tierData(250000);

const decadeAt100k = t100.all.filter(r => r.years > 10).map(r => r.name);
const tableRows = rows
  .map(r => ({
    ...r,
    y50: +(yrs(50000, r.single)).toFixed(1),
    y100: +(yrs(100000, r.single)).toFixed(1),
    y250: +(yrs(250000, r.single)).toFixed(1),
  }))
  .sort((a, b) => b.y100 - a.y100);

const coupleRatioPct = Math.round(
  (rows.reduce((s, r) => s + r.couple / r.single, 0) / countryCount - 1) * 100
);

const updated = 'July 2026';
const t100Max = t100.top12[0].years;
const t50Max = t50.top12[0].years;
const t250Max = t250.top12[0].years;

const datasetSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '2026 Runway Report: Savings Runway by Country',
  description: `How long $50,000, $100,000, and $250,000 in savings lasts across ${countryCount} countries, based on baseline single-person monthly cost of living.`,
  url: 'https://leavingamerica.co/statistics/2026-runway-report/',
  creator: { '@type': 'Organization', name: 'LeavingAmerica.co', url: 'https://leavingamerica.co' },
  dateModified: qualityScoresData.lastUpdated,
  license: 'https://leavingamerica.co/methodology/',
  variableMeasured: [
    'Monthly cost of living (USD, single person)',
    'Savings runway in years at $50,000',
    'Savings runway in years at $100,000',
    'Savings runway in years at $250,000',
  ],
});
---

<BaseLayout
  title="2026 Runway Report: How Long $50K–$250K Lasts Abroad"
  description={`How long $50,000, $100,000, and $250,000 in savings lasts across ${countryCount} countries, versus a typical US city. Sourced, citable data for journalists and researchers.`}
  ogTitle="2026 Runway Report: How Long American Savings Last Abroad"
>
  <script type="application/ld+json" set:html={datasetSchema} />

<style is:global>
:root { --rwr-ease: cubic-bezier(0.22, 1, 0.36, 1); }

/* ═══ HERO ═══ */
.rwr-hero {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, #0a1120 0%, #10203f 48%, #0b1830 100%);
  color: #fff; padding: 92px 0 78px; text-align: center;
}
.rwr-orb { position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none; }
.rwr-orb-1 { width: 640px; height: 640px; background: #2563eb; opacity: 0.42; top: -220px; left: -120px; }
.rwr-orb-2 { width: 520px; height: 520px; background: #0891b2; opacity: 0.34; bottom: -180px; right: -120px; }
.rwr-dots {
  position: absolute; inset: 0;
  background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
  background-size: 30px 30px; pointer-events: none;
  mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, #000 40%, transparent 100%);
  -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, #000 40%, transparent 100%);
}
.rwr-hero-inner { max-width: 900px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 1; }
.rwr-pill {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 6px 16px; background: rgba(59,130,246,0.16);
  border: 1px solid rgba(96,165,250,0.35); border-radius: 30px;
  font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  color: #93c5fd; margin-bottom: 24px;
}
.rwr-pill-dot { width: 7px; height: 7px; border-radius: 50%; background: #34d399; box-shadow: 0 0 0 0 rgba(52,211,153,0.7); animation: rwr-pulse 2s infinite; }
@keyframes rwr-pulse { 0% { box-shadow: 0 0 0 0 rgba(52,211,153,0.6); } 70% { box-shadow: 0 0 0 8px rgba(52,211,153,0); } 100% { box-shadow: 0 0 0 0 rgba(52,211,153,0); } }
.rwr-hero h1 {
  font-size: clamp(28px, 5vw, 50px); font-weight: 800; letter-spacing: -0.03em;
  line-height: 1.1; margin: 0 0 18px;
  background: linear-gradient(180deg, #ffffff 0%, #bcd2f5 100%);
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
.rwr-hero-sub { font-size: clamp(15px, 2.1vw, 18px); color: rgba(255,255,255,0.66); max-width: 640px; margin: 0 auto; line-height: 1.6; }
.rwr-hero-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 46px; }
.rwr-hs { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 22px 14px 18px; backdrop-filter: blur(8px); }
.rwr-hs-num { font-size: clamp(24px, 3.4vw, 36px); font-weight: 800; letter-spacing: -0.02em; line-height: 1; color: #fff; }
.rwr-hs-num.grad { background: linear-gradient(120deg, #60a5fa, #22d3ee); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.rwr-hs-label { font-size: 12px; color: rgba(255,255,255,0.55); margin-top: 8px; line-height: 1.35; }
.rwr-meta { font-size: 13px; color: rgba(255,255,255,0.4); margin-top: 36px; }
.rwr-meta a { color: rgba(255,255,255,0.55); }

/* ═══ BODY ═══ */
.rwr-body { background: #f8fafc; }
.rwr-section { padding: 60px 0 12px; }
.rwr-section:last-of-type { padding-bottom: 72px; }
.rwr-wrap { max-width: 900px; margin: 0 auto; padding: 0 24px; }
.rwr-eyebrow { font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #2563eb; margin: 0 0 8px; }
.rwr-section h2 { font-size: clamp(21px, 3.2vw, 30px); font-weight: 800; color: #0f172a; letter-spacing: -0.02em; margin: 0 0 6px; line-height: 1.2; }
.rwr-section-sub { font-size: 14px; color: #64748b; margin: 0 0 28px; max-width: 640px; }

.rwr-reveal { opacity: 0; transform: translateY(22px); transition: opacity 0.7s var(--rwr-ease), transform 0.7s var(--rwr-ease); }
.rwr-reveal.in { opacity: 1; transform: none; }

/* ═══ KEY FINDINGS ═══ */
.rwr-kf-list { list-style: none; margin: 0; padding: 0; counter-reset: rwr-kf; display: flex; flex-direction: column; gap: 14px; }
.rwr-kf-item {
  counter-increment: rwr-kf; position: relative;
  background: #fff; border: 1px solid #e6ebf2; border-radius: 14px;
  padding: 18px 20px 18px 58px; font-size: 14.5px; color: #334155; line-height: 1.65;
}
.rwr-kf-item::before {
  content: counter(rwr-kf); position: absolute; left: 18px; top: 18px;
  width: 26px; height: 26px; border-radius: 8px;
  background: linear-gradient(135deg, #2563eb, #22d3ee); color: #fff;
  font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center;
}
.rwr-kf-item strong { color: #0f172a; }

/* CTA / cite */
.rwr-cta { background: linear-gradient(135deg, #eff6ff, #eef2ff); border: 1px solid #dbe4fb; border-radius: 16px; padding: 20px 24px; margin-top: 30px; font-size: 14px; color: #334155; line-height: 1.6; }
.rwr-cta a { color: #2563eb; font-weight: 700; text-decoration: none; }
.rwr-cta a:hover { text-decoration: underline; }
.rwr-cite { background: #0f1e38; color: #cbd9f0; border-radius: 16px; padding: 24px 26px; font-size: 14px; line-height: 1.65; margin-top: 40px; }
.rwr-cite strong { color: #fff; }
.rwr-cite a { color: #7dd3fc; }

/* ═══ BAR CHART ═══ */
.rwr-chart { background: #fff; border: 1px solid #e6ebf2; border-radius: 18px; padding: 26px 26px 22px; }
.rwr-bar-row { display: grid; grid-template-columns: 148px 1fr auto; align-items: center; gap: 14px; padding: 9px 0; }
.rwr-bar-label { display: flex; align-items: center; gap: 9px; font-size: 13.5px; font-weight: 600; color: #1e293b; min-width: 0; }
.rwr-bar-label .fi { width: 22px; height: 16px; border-radius: 3px; flex-shrink: 0; box-shadow: 0 0 0 1px rgba(0,0,0,0.12); }
.rwr-bar-label span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rwr-bar-track { height: 26px; background: #f1f5f9; border-radius: 8px; overflow: hidden; }
.rwr-bar-fill { height: 100%; width: 0; border-radius: 8px; transition: width 1.1s var(--rwr-ease); }
.rwr-bar-fill.green { background: linear-gradient(90deg, #10b981, #34d399); }
.rwr-bar-fill.blue { background: linear-gradient(90deg, #2563eb, #22d3ee); }
.rwr-bar-fill.amber { background: linear-gradient(90deg, #b45309, #f59e0b); }
.rwr-bar-val { font-size: 13.5px; font-weight: 800; color: #0f172a; white-space: nowrap; }
.rwr-chart-note { font-size: 12.5px; color: #94a3b8; margin: 16px 0 0; }

/* ═══ METHODOLOGY ═══ */
.rwr-meth { background: #fff; border: 1px solid #e6ebf2; border-radius: 16px; padding: 24px 26px; }
.rwr-meth p { font-size: 14px; color: #334155; line-height: 1.75; margin: 0 0 14px; }
.rwr-meth p:last-child { margin-bottom: 0; }
.rwr-meth code { background: #f1f5f9; padding: 2px 6px; border-radius: 6px; font-size: 13px; }

/* ═══ FULL TABLE ═══ */
.rwr-table-tools { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
.rwr-search { position: relative; flex: 1; min-width: 220px; }
.rwr-search input {
  width: 100%; padding: 11px 14px 11px 38px; font-size: 14px; font-family: inherit;
  border: 1.5px solid #cbd5e1; border-radius: 10px; outline: none; box-sizing: border-box; color: #0f172a;
  transition: border-color 0.15s, box-shadow 0.15s; background: #fff;
}
.rwr-search input:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.12); }
.rwr-search svg { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: #94a3b8; }
.rwr-search-count { font-size: 13px; color: #94a3b8; white-space: nowrap; }
.rwr-scroll-hint { display: none; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 700; color: #2563eb; margin: 0 0 10px; }
.rwr-scroll-hint.show { display: inline-flex; }
.rwr-scroll-hint svg { animation: rwr-swipe 1.5s ease-in-out infinite; }
@keyframes rwr-swipe { 0%, 100% { transform: translateX(0); opacity: 0.55; } 50% { transform: translateX(4px); opacity: 1; } }
.rwr-table-scroll { position: relative; overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid #e6ebf2; border-radius: 14px; background: #fff; }
.rwr-table-fade {
  position: absolute; top: 0; right: 0; bottom: 0; width: 40px;
  background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,0.97));
  pointer-events: none; border-radius: 0 14px 14px 0; opacity: 0; transition: opacity 0.25s ease;
}
.rwr-table-fade.show { opacity: 1; }
table.rwr-table { width: 100%; border-collapse: collapse; font-size: 13.5px; min-width: 560px; }
.rwr-table thead th { position: sticky; top: 0; background: #0f1e38; color: #cbd9f0; font-weight: 700; text-align: left; padding: 13px 16px; font-size: 12px; letter-spacing: 0.02em; white-space: nowrap; }
.rwr-table thead th.num { text-align: right; }
.rwr-table tbody td { padding: 11px 16px; border-top: 1px solid #eef2f7; color: #334155; }
.rwr-table tbody td.num { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; color: #0f172a; }
.rwr-table tbody tr:hover { background: #f8fafc; }
.rwr-table tbody tr:nth-child(even) { background: #fcfdff; }
.rwr-table tbody tr:nth-child(even):hover { background: #f8fafc; }
.rwr-tc-name { display: flex; align-items: center; gap: 10px; }
.rwr-tc-name a { color: #1e293b; text-decoration: none; font-weight: 600; }
.rwr-tc-name a:hover { color: #2563eb; }
.rwr-tc-name .fi { width: 22px; height: 16px; border-radius: 3px; flex-shrink: 0; box-shadow: 0 0 0 1px rgba(0,0,0,0.12); }
.rwr-noresults { display: none; text-align: center; padding: 32px; color: #94a3b8; font-size: 14px; }

@media (max-width: 720px) {
  .rwr-hero-stats { grid-template-columns: 1fr 1fr; }
  .rwr-bar-row { grid-template-columns: 118px 1fr auto; gap: 10px; }
  .rwr-bar-label { font-size: 12.5px; }
  .rwr-kf-item { padding-left: 52px; }
}
@media (prefers-reduced-motion: reduce) {
  .rwr-reveal { opacity: 1; transform: none; transition: none; }
  .rwr-bar-fill { transition: none; }
  .rwr-pill-dot { animation: none; }
}
</style>

<!-- HERO -->
<section class="rwr-hero">
  <div class="rwr-orb rwr-orb-1"></div>
  <div class="rwr-orb rwr-orb-2"></div>
  <div class="rwr-dots"></div>
  <div class="rwr-hero-inner">
    <span class="rwr-pill"><span class="rwr-pill-dot"></span>Live data · {countryCount} countries · Free to cite</span>
    <h1>2026 Runway Report:<br/>How Long American Savings Last Abroad</h1>
    <p class="rwr-hero-sub">How many years $50,000, $100,000, and $250,000 in savings actually buys, country by country, compared with a typical US city. Every number below is computed live from LeavingAmerica.co's dataset.</p>
    <div class="rwr-hero-stats">
      <div class="rwr-hs"><div class="rwr-hs-num grad" data-count={t100.avg} data-suffix=" yrs">0</div><div class="rwr-hs-label">avg. runway on $100K, across {countryCount} countries</div></div>
      <div class="rwr-hs"><div class="rwr-hs-num" data-count={t100.usYears} data-suffix=" yrs">0</div><div class="rwr-hs-label">what $100K buys in a typical $3,500/mo US city</div></div>
      <div class="rwr-hs"><div class="rwr-hs-num grad" data-count={t100.longest.years} data-suffix=" yrs">0</div><div class="rwr-hs-label">longest $100K runway ({t100.longest.name})</div></div>
      <div class="rwr-hs"><div class="rwr-hs-num" data-count={countryCount}>0</div><div class="rwr-hs-label">countries with full cost data</div></div>
    </div>
    <p class="rwr-meta">Sourced from LeavingAmerica.co's cost-of-living dataset · Updated {updated} · <a href="/methodology/">Methodology</a></p>
  </div>
</section>

<div class="rwr-body">

  <!-- KEY FINDINGS -->
  <section class="rwr-section">
    <div class="rwr-wrap">
      <p class="rwr-eyebrow rwr-reveal">Key Findings</p>
      <h2 class="rwr-reveal">The Numbers, In Plain English</h2>
      <p class="rwr-section-sub rwr-reveal">Free to cite in articles, newsletters, and research with attribution and a link to this page.</p>
      <ol class="rwr-kf-list rwr-reveal">
        <li class="rwr-kf-item"><strong>$100,000 in savings lasts an average of {t100.avg} years</strong> across the {countryCount} countries tracked here, more than double the {t100.usYears} years the same amount lasts in a typical $3,500/month US city.</li>
        <li class="rwr-kf-item"><strong>{t100.longest.name} offers the longest runway at every savings level tracked:</strong> $50,000 lasts {t50.longest.years} years, $100,000 lasts {t100.longest.years} years, and $250,000 lasts nearly {Math.floor(t250.longest.years)} years ({t250.longest.years}).</li>
        <li class="rwr-kf-item"><strong>{t250.shortest.name} offers the shortest runway tracked:</strong> even $250,000 lasts just {t250.shortest.years} years, about a sixth of what the same sum buys in {t250.longest.name}.</li>
        <li class="rwr-kf-item"><strong>At $100,000, savings last more than a decade in {t100.over10} of {countryCount} tracked countries:</strong> {decadeAt100k.join(', ')}.</li>
        <li class="rwr-kf-item"><strong>At $250,000, that jumps to {t250.over10} of {countryCount} countries</strong> lasting more than ten years, versus {t250.usYears} years for the same amount in a typical US city.</li>
        <li class="rwr-kf-item"><strong>Couples spend {coupleRatioPct}% more than singles on average</strong> across the same countries, meaningfully shortening runway for two-person households versus solo movers.</li>
      </ol>
    </div>
  </section>

  <!-- $50K -->
  <section class="rwr-section">
    <div class="rwr-wrap">
      <p class="rwr-eyebrow rwr-reveal">Tier 1</p>
      <h2 class="rwr-reveal">How Long $50,000 Lasts</h2>
      <p class="rwr-section-sub rwr-reveal">Ranked by years of runway for a single person at a normal lifestyle, no other income. Top 12 of {countryCount} shown.</p>
      <div class="rwr-chart rwr-reveal">
        {t50.top12.map(r => (
          <div class="rwr-bar-row">
            <div class="rwr-bar-label"><span class={`fi fi-${r.iso2}`}></span><span>{r.name}</span></div>
            <div class="rwr-bar-track"><div class="rwr-bar-fill green" data-bar={Math.round((r.years / t50Max) * 100)}></div></div>
            <div class="rwr-bar-val">{r.years} yrs</div>
          </div>
        ))}
        <p class="rwr-chart-note">{t50.shortest.name} sits at the other end at {t50.shortest.years} years. The {countryCount}-country average is {t50.avg} years, versus {t50.usYears} years for the same amount in a typical $3,500/month US city.</p>
      </div>
    </div>
  </section>

  <!-- $100K -->
  <section class="rwr-section">
    <div class="rwr-wrap">
      <p class="rwr-eyebrow rwr-reveal">Tier 2</p>
      <h2 class="rwr-reveal">How Long $100,000 Lasts</h2>
      <p class="rwr-section-sub rwr-reveal">Same method, double the savings. Single person, normal lifestyle, no other income. These 12 stretch it furthest.</p>
      <div class="rwr-chart rwr-reveal">
        {t100.top12.map(r => (
          <div class="rwr-bar-row">
            <div class="rwr-bar-label"><span class={`fi fi-${r.iso2}`}></span><span>{r.name}</span></div>
            <div class="rwr-bar-track"><div class="rwr-bar-fill blue" data-bar={Math.round((r.years / t100Max) * 100)}></div></div>
            <div class="rwr-bar-val">{r.years} yrs</div>
          </div>
        ))}
        <p class="rwr-chart-note">The {countryCount}-country average is {t100.avg} years. {t100.shortest.name}, the priciest country tracked, turns the same $100,000 into just {t100.shortest.years} years, close to the {t100.usYears} years it buys in a typical US city.</p>
      </div>
      <div class="rwr-cta rwr-reveal">Run these numbers for your own savings and lifestyle: the <a href="/runway/">Runway Calculator</a> shows your exact number in every country, instantly.</div>
    </div>
  </section>

  <!-- $250K -->
  <section class="rwr-section">
    <div class="rwr-wrap">
      <p class="rwr-eyebrow rwr-reveal">Tier 3</p>
      <h2 class="rwr-reveal">How Long $250,000 Lasts</h2>
      <p class="rwr-section-sub rwr-reveal">The same calculation at a quarter-million in savings. Single person, normal lifestyle, no other income.</p>
      <div class="rwr-chart rwr-reveal">
        {t250.top12.map(r => (
          <div class="rwr-bar-row">
            <div class="rwr-bar-label"><span class={`fi fi-${r.iso2}`}></span><span>{r.name}</span></div>
            <div class="rwr-bar-track"><div class="rwr-bar-fill amber" data-bar={Math.round((r.years / t250Max) * 100)}></div></div>
            <div class="rwr-bar-val">{r.years} yrs</div>
          </div>
        ))}
        <p class="rwr-chart-note">At this level, {t250.over10} of {countryCount} countries pass the ten-year mark. {t250.shortest.name} is the outlier at just {t250.shortest.years} years, versus {t250.usYears} in a typical US city.</p>
      </div>
    </div>
  </section>

  <!-- FULL TABLE -->
  <section class="rwr-section">
    <div class="rwr-wrap">
      <p class="rwr-eyebrow rwr-reveal">The Full Dataset</p>
      <h2 class="rwr-reveal">Runway at Every Savings Tier, All {countryCount} Countries</h2>
      <p class="rwr-section-sub rwr-reveal">Monthly baseline cost and years of runway at $50K / $100K / $250K, single person, no additional income. Sorted by $100K runway, longest first.</p>
      <div class="rwr-table-tools rwr-reveal">
        <div class="rwr-search">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.6"/><path d="M11 11l3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <input type="text" id="rwr-tbl-search" placeholder="Search a country…" aria-label="Search countries" />
        </div>
        <span class="rwr-search-count" id="rwr-tbl-count">{countryCount} countries</span>
      </div>
      <p class="rwr-scroll-hint" id="rwr-scroll-hint">
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M2 7.5h11M9 4l4 3.5-4 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Swipe to see all columns
      </p>
      <div class="rwr-table-scroll rwr-reveal" id="rwr-table-scroll">
        <table class="rwr-table">
          <thead>
            <tr>
              <th>Country</th>
              <th class="num">Monthly cost</th>
              <th class="num">$50K</th>
              <th class="num">$100K</th>
              <th class="num">$250K</th>
            </tr>
          </thead>
          <tbody id="rwr-tbl-body">
            {tableRows.map(r => (
              <tr data-name={r.name.toLowerCase()}>
                <td><span class="rwr-tc-name"><span class={`fi fi-${r.iso2}`}></span><a href={`/countries/${r.slug}/`}>{r.name}</a></span></td>
                <td class="num">${r.single.toLocaleString()}/mo</td>
                <td class="num">{r.y50} yrs</td>
                <td class="num">{r.y100} yrs</td>
                <td class="num">{r.y250} yrs</td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="rwr-noresults" id="rwr-tbl-none">No country matches that search.</div>
        <div class="rwr-table-fade" id="rwr-table-fade" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- METHODOLOGY -->
  <section class="rwr-section">
    <div class="rwr-wrap">
      <p class="rwr-eyebrow rwr-reveal">Methodology</p>
      <h2 class="rwr-reveal">How This Was Calculated</h2>
      <div class="rwr-meth rwr-reveal">
        <p>Runway in years is calculated as <code>savings ÷ monthly cost of living ÷ 12</code>, using each country's baseline single-person monthly cost as tracked by LeavingAmerica.co, sourced from the WhereNext open data API (getwherenext.com) and updated quarterly.</p>
        <p>This assumes no additional income during the period (no remote salary, Social Security, or investment distributions) and a constant cost of living, at a "normal" (non-lean, non-luxury) lifestyle. The interactive <a href="/runway/">Runway Calculator</a> lets you factor in income and adjust lifestyle level for your own numbers.</p>
        <p>The US comparison figure uses $3,500/month as a typical mid-cost US city baseline, the same figure used elsewhere on LeavingAmerica.co's <a href="/statistics/americans-moving-abroad/">statistics page</a>.</p>
        <p>Figures do not account for one-time relocation costs, visa or legal residency limits on how long you may stay, healthcare costs, currency risk, or US tax obligations (which apply to citizens regardless of where they live). This report reflects data current as of {updated}. Full methodology: <a href="/methodology/">leavingamerica.co/methodology</a>.</p>
      </div>

      <div class="rwr-cite rwr-reveal">
        <strong>Citing this report:</strong> every figure here is free to use in articles, newsletters, and research with attribution and a link to this page. Journalists can reach me for custom numbers on any country or savings amount: <a href="mailto:contact@leavingamerica.co">contact@leavingamerica.co</a>.
      </div>
    </div>
  </section>

</div>

<script>
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var revEls = Array.prototype.slice.call(document.querySelectorAll('.rwr-reveal'));
  if (reduce) {
    revEls.forEach(function (el) { el.classList.add('in'); });
  } else {
    var revObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); revObs.unobserve(e.target); } });
    }, { threshold: 0.12 });
    revEls.forEach(function (el) { revObs.observe(el); });
  }

  function fmt(n) {
    return (Math.round(n * 10) / 10).toLocaleString('en-US', { minimumFractionDigits: n % 1 !== 0 ? 1 : 0, maximumFractionDigits: 1 });
  }
  function animateCount(el) {
    var target = parseFloat(el.getAttribute('data-count')) || 0;
    var prefix = el.getAttribute('data-prefix') || '';
    var suffix = el.getAttribute('data-suffix') || '';
    if (reduce) { el.textContent = prefix + fmt(target) + suffix; return; }
    var dur = 1300, start = null;
    function step(ts) {
      if (!start) start = ts;
      var p = Math.min((ts - start) / dur, 1);
      var eased = 1 - Math.pow(1 - p, 3);
      el.textContent = prefix + fmt(target * eased) + suffix;
      if (p < 1) requestAnimationFrame(step);
      else el.textContent = prefix + fmt(target) + suffix;
    }
    requestAnimationFrame(step);
  }
  var countEls = Array.prototype.slice.call(document.querySelectorAll('[data-count]'));
  var countObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) { animateCount(e.target); countObs.unobserve(e.target); } });
  }, { threshold: 0.6 });
  countEls.forEach(function (el) { countObs.observe(el); });

  var barEls = Array.prototype.slice.call(document.querySelectorAll('[data-bar]'));
  function fillBar(el) {
    var w = el.getAttribute('data-bar') + '%';
    if (reduce) { el.style.width = w; return; }
    requestAnimationFrame(function () { el.style.width = w; });
  }
  var barObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) { fillBar(e.target); barObs.unobserve(e.target); } });
  }, { threshold: 0.4 });
  barEls.forEach(function (el) { barObs.observe(el); });

  var search = document.getElementById('rwr-tbl-search');
  var rowsEl = Array.prototype.slice.call(document.querySelectorAll('#rwr-tbl-body tr'));
  var countEl = document.getElementById('rwr-tbl-count');
  var noneEl = document.getElementById('rwr-tbl-none');
  if (search) {
    search.addEventListener('input', function () {
      var q = search.value.trim().toLowerCase();
      var shown = 0;
      rowsEl.forEach(function (tr) {
        var match = tr.getAttribute('data-name').indexOf(q) !== -1;
        tr.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      countEl.textContent = shown + (shown === 1 ? ' country' : ' countries');
      noneEl.style.display = shown === 0 ? 'block' : 'none';
    });
  }

  var tblScroll = document.getElementById('rwr-table-scroll');
  var tblFade = document.getElementById('rwr-table-fade');
  var tblHint = document.getElementById('rwr-scroll-hint');
  if (tblScroll && tblFade && tblHint) {
    function updateScrollState() {
      var hasOverflow = tblScroll.scrollWidth > tblScroll.clientWidth + 2;
      var atEnd = tblScroll.scrollLeft + tblScroll.clientWidth >= tblScroll.scrollWidth - 4;
      tblFade.classList.toggle('show', hasOverflow && !atEnd);
      tblHint.classList.toggle('show', hasOverflow);
    }
    updateScrollState();
    tblScroll.addEventListener('scroll', updateScrollState, { passive: true });
    window.addEventListener('resize', updateScrollState);
  }
</script>

</BaseLayout>
